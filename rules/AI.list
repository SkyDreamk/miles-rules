# AI 应用分流规则（自维护）
# 覆盖：Muse / ChatGPT / Gemini / Claude / Copilot / Grok / Perplexity / Poe / Mistral / Apple Intelligence
# 用法：RULE-SET,https://cdn.jsdelivr.net/gh/你的用户名/miles-rules@main/rules/AI.list,"AI Suite",extended-matching
# 注意：api.meta.ai 为社区反馈的 Muse 接口域名，未经官方确认
# ---------- Muse（Meta AI） ----------
DOMAIN-SUFFIX,muse.ai
# api.meta.ai 为社区反馈的 Muse 接口域名，未经官方确认；如 Muse 异常可优先排查此条
DOMAIN-SUFFIX,api.meta.ai

# ---------- ChatGPT / OpenAI ----------
DOMAIN-SUFFIX,chatgpt.com
DOMAIN-SUFFIX,openai.com
DOMAIN-SUFFIX,oaistatic.com
DOMAIN-SUFFIX,oaiusercontent.com

# ---------- Google Gemini ----------
DOMAIN-SUFFIX,gemini.google.com
DOMAIN-SUFFIX,aistudio.google.com
DOMAIN-SUFFIX,generativelanguage.googleapis.com

# ---------- Claude / Anthropic ----------
DOMAIN-SUFFIX,anthropic.com
DOMAIN-SUFFIX,claude.ai
DOMAIN-SUFFIX,claudeusercontent.com

# ---------- Microsoft Copilot ----------
DOMAIN-SUFFIX,copilot.microsoft.com

# ---------- xAI Grok ----------
DOMAIN-SUFFIX,grok.com
DOMAIN-SUFFIX,x.ai

# ---------- Perplexity ----------
DOMAIN-SUFFIX,perplexity.ai

# ---------- Poe ----------
DOMAIN-SUFFIX,poe.com

# ---------- Mistral ----------
DOMAIN-SUFFIX,mistral.ai

# ---------- Apple Intelligence / Siri ----------
